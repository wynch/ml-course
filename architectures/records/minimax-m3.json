  "basis": "code",
  "steps": [
   {
    "kind": "rmsnorm",
    "label": "Gemma-style (1 + w)"
   },
   {
    "kind": "sparse_topk",
    "label": "MSA: index branch picks 16 key blocks of 128 per KV group, local block always kept",
    "only_on": "msa"
   },
   {
    "kind": "gqa",
    "label": "64 query heads, 4 KV heads; per-head QK-norm; RoPE on 64 of 128 dims"
   },
   {
    "kind": "residual_add"
   },
   {
    "kind": "rmsnorm"
   },
   {
    "kind": "moe",
    "label": "1 shared + top-4 of 128 (dense 12288 in layers 1-3); clamped SwiGLU"
   },
   {
    "kind": "residual_add"
   }
  ]
 },
 "specials": [
  {
   "name": "sparse_topk",
   "what": "MiniMax Sparse Attention: block-level selection per GQA group, block size 128, top 16 blocks, local block forced; index branch has no value path",
   "where": "layers 4-60"
  },
  {
   "name": "dense_prefix",
   "what": "first three layers: dense FFN and full attention",
   "where": "layers 1-3"
  },
  {
   "name": "mtp",
   "what": "config num_mtp_modules 7; no MTP tensors in the released index and the transformers code ignores mtp.*",
   "where": "after the main stack"
  },
  {
   "name": "swiglu",
   "what": "swigluoai: gate and up clamped at 7, sigmoid(1.702 x) gate (gpt-oss form)",
   "where": "every FFN"
  }
 ],
